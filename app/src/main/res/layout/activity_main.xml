<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header with Month/Year and Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#2196F3">

        <Button
            android:id="@+id/btnPrevMonth"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="◀"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:id="@+id/tvMonthYear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="December 2024"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center"/>

        <Button
            android:id="@+id/btnNextMonth"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="▶"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>

    <!-- Selection Mode Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnSingleDate"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Single"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_mode_button"
            android:textColor="@color/mode_button_text"/>

        <Button
            android:id="@+id/btnMultiDate"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Multi"
            android:textSize="12sp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_mode_button"
            android:textColor="@color/mode_button_text"/>

        <Button
            android:id="@+id/btnDateRange"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Range"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_mode_button"
            android:textColor="@color/mode_button_text"/>

    </LinearLayout>

    <!-- Swipe Instruction -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Swipe left/right for months • Swipe up/down for years"
        android:textSize="11sp"
        android:textColor="#666666"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"/>

    <!-- Calendar Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCalendar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:padding="8dp"
        android:clipToPadding="false"/>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnShowSelected"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Show Selected"
            android:textSize="14sp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#4CAF50"/>

        <Button
            android:id="@+id/btnClearSelection"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Clear"
            android:textSize="14sp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#F44336"/>

    </LinearLayout>

</LinearLayout>